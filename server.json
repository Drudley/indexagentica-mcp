  "version": "0.1.0",
  "websiteUrl": "https://indexagentica.com/agents/",
  "icons": [
    {
      "src": "https://indexagentica.com/logo-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://indexagentica.com/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/Drudley/indexagentica-mcp",
    "source": "github",
    "id": "1402134828"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.indexagentica.com/mcp"
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": [
        "search",
        "get_entry",
        "get_content",
        "list_categories"
      ],
      "auth": "none",
      "rateLimit": "120 requests/min per IP",
      "llmsTxt": "https://indexagentica.com/llms.txt"
    }
  }
