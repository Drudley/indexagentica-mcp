{
  "name": "indexagentica-mcp",
  "version": "0.1.0",
  "description": "Read-only remote MCP server (Streamable HTTP) and REST search API for indexagentica.com, on Cloudflare Workers.",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "test:unit": "node --test test/unit.test.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test": "scripts/test-local.sh",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:dry": "wrangler deploy --env=\"\" --dry-run --outdir dist"
  },
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.9.0",
    "wrangler": "^4.147.0"
  },
  "private": true,
  "type": "module"
}
